ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...

# NOTE: 아래 GPT_MODEL / GEMINI_MODEL 기본값은 시간이 지나면 구버전이 될 수 있으니
# 실행 전 OpenAI / Google AI Studio에서 현재 사용 가능한 모델명을 확인하세요.
CLAUDE_MODEL=claude-opus-4-8
GPT_MODEL=gpt-4o
GEMINI_MODEL=gemini-1.5-pro
JUDGE_MODEL=claude-opus-4-8

MAX_ITERATIONS=5
CONSENSUS_THRESHOLD=85